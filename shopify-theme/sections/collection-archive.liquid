<section id="collection" class="section-dark" style="border-top: 1px solid var(--color-surface-border);">
  <div class="container">
    <div class="collection-header">
      <div>
        <h2 class="heading-display" style="font-size: clamp(2rem, 3.8vw, 3rem);">THE FORGED WHEEL ARCHIVE</h2>
        <p style="color: var(--color-text-secondary); max-width: 620px; margin-top: 0.5rem; font-size: 0.95rem;">
          Ten bespoke architectures engineered from aerospace-grade 6061-T6 aluminum. Monoblock 1-piece, 2-piece modular stepped lip, and 3-piece custom forged configurations.
        </p>
      </div>

      <div class="collection-filters">
        <button class="filter-pill active" data-filter="all">ALL ARCHIVES (10)</button>
        <button class="filter-pill" data-filter="monoblock">1-PC MONOBLOCK</button>
        <button class="filter-pill" data-filter="modular">2-PC MODULAR</button>
        <button class="filter-pill" data-filter="three-piece">3-PC CUSTOM</button>
      </div>
    </div>

    <div class="wheel-grid">
      <!-- AF-01 TRACKLIGHT -->
      <div class="wheel-card" data-category="monoblock">
        <div class="wheel-card-media">
          <span class="badge-verified wheel-card-badge" style="background: rgba(0,0,0,0.85); color: #fff; border-color: #444;">1-PC MONOBLOCK</span>
          <img src="https://images.unsplash.com/photo-1578844251758-2f71da64c96f?auto=format&fit=crop&w=600&q=80" alt="AGNI AF-01 Tracklight Monoblock" />
        </div>
        <div class="wheel-card-body">
          <div class="wheel-code">AF-01 TRACKLIGHT</div>
          <div class="wheel-subtitle">Twin 5-Spoke with Side-Hollow Milling</div>
          <div class="wheel-specs-list">
            <div class="spec-cell">
              <span class="spec-cell-label">WEIGHT FROM</span>
              <span class="spec-cell-value">8.6 KG (19")</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">DIAMETERS</span>
              <span class="spec-cell-value">19" – 22"</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">BRAKE CLEARANCE</span>
              <span class="spec-cell-value">Up to 440mm PCCB</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">CONSTRUCTION</span>
              <span class="spec-cell-value">6061-T6 Billet</span>
            </div>
          </div>
          <div class="wheel-card-footer">
            <div>
              <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-secondary); display:block;">SET OF 4 FROM</span>
              <span class="wheel-price">$3,900</span>
            </div>
            <div style="display:flex; gap:0.5rem; align-items:center;">
              <button class="btn-card-visualize" data-action="open-ai-garage" data-wheel-code="AF-01">
                <span>AI GARAGE</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- AF-02 DIRECTIONAL GT -->
      <div class="wheel-card" data-category="monoblock">
        <div class="wheel-card-media">
          <span class="badge-verified wheel-card-badge" style="background: rgba(0,0,0,0.85); color: #fff; border-color: #444;">1-PC MONOBLOCK</span>
          <img src="https://images.unsplash.com/photo-1611821064430-0d40291d0f0b?auto=format&fit=crop&w=600&q=80" alt="AGNI AF-02 Directional GT" />
        </div>
        <div class="wheel-card-body">
          <div class="wheel-code">AF-02 DIRECTIONAL GT</div>
          <div class="wheel-subtitle">Turbine Aero Slotted V-Spoke (L/R)</div>
          <div class="wheel-specs-list">
            <div class="spec-cell">
              <span class="spec-cell-label">WEIGHT FROM</span>
              <span class="spec-cell-value">9.1 KG (20")</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">DIAMETERS</span>
              <span class="spec-cell-value">20" – 23"</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">BRAKE CLEARANCE</span>
              <span class="spec-cell-value">High Offset Calipers</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">ORIENTATION</span>
              <span class="spec-cell-value">Directional Handed</span>
            </div>
          </div>
          <div class="wheel-card-footer">
            <div>
              <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-secondary); display:block;">SET OF 4 FROM</span>
              <span class="wheel-price">$4,200</span>
            </div>
            <button class="btn-card-visualize" data-action="open-ai-garage" data-wheel-code="AF-02">
              <span>AI GARAGE</span>
            </button>
          </div>
        </div>
      </div>

      <!-- AF-03 CUP COMPETITION -->
      <div class="wheel-card" data-category="monoblock">
        <div class="wheel-card-media">
          <span class="badge-verified wheel-card-badge" style="background: rgba(0,0,0,0.85); color: #fff; border-color: #444;">1-PC MONOBLOCK</span>
          <img src="https://images.unsplash.com/photo-1563720223185-11003d516935?auto=format&fit=crop&w=600&q=80" alt="AGNI AF-03 Cup Competition" />
        </div>
        <div class="wheel-card-body">
          <div class="wheel-code">AF-03 CUP COMPETITION</div>
          <div class="wheel-subtitle">Split Y-Spoke Motorsport Monoblock</div>
          <div class="wheel-specs-list">
            <div class="spec-cell">
              <span class="spec-cell-label">WEIGHT FROM</span>
              <span class="spec-cell-value">8.8 KG (19")</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">DIAMETERS</span>
              <span class="spec-cell-value">19" – 21"</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">BRAKE CLEARANCE</span>
              <span class="spec-cell-value">GT3 Cup Spec</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">BEAD SEAT</span>
              <span class="spec-cell-value">Knurled Anti-Slip</span>
            </div>
          </div>
          <div class="wheel-card-footer">
            <div>
              <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-secondary); display:block;">SET OF 4 FROM</span>
              <span class="wheel-price">$4,100</span>
            </div>
            <button class="btn-card-visualize" data-action="open-ai-garage" data-wheel-code="AF-03">
              <span>AI GARAGE</span>
            </button>
          </div>
        </div>
      </div>

      <!-- AF-04 MODULAR STEP-LIP (2-Piece) -->
      <div class="wheel-card" data-category="modular">
        <div class="wheel-card-media">
          <span class="badge-orange wheel-card-badge" style="background: rgba(255, 77, 0, 0.15); border-color: var(--color-accent); color: var(--color-accent);">2-PC MODULAR</span>
          <img src="https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=600&q=80" alt="AGNI AF-04 Modular Step-Lip" />
        </div>
        <div class="wheel-card-body">
          <div class="wheel-code">AF-04 MODULAR STEP-LIP</div>
          <div class="wheel-subtitle">Mirror Stepped Lip + ARP Titanium Bolts</div>
          <div class="wheel-specs-list">
