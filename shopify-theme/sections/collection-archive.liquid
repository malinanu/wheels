            <div class="spec-cell">
              <span class="spec-cell-label">LIP DEPTH</span>
              <span class="spec-cell-value">Up to 4.5" Stepped</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">HARDWARE</span>
              <span class="spec-cell-value">Titanium Fasteners</span>
            </div>
          </div>
          <div class="wheel-card-footer">
            <div>
              <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-secondary); display:block;">SET OF 4 FROM</span>
              <span class="wheel-price">$4,800</span>
            </div>
            <button class="btn-card-visualize" data-action="open-ai-garage" data-wheel-code="AF-04">
              <span>AI GARAGE</span>
            </button>
          </div>
        </div>
      </div>

      <!-- AF-08 CENTERLOCK RS -->
      <div class="wheel-card" data-category="monoblock">
        <div class="wheel-card-media">
          <span class="badge-verified wheel-card-badge" style="background: rgba(0,0,0,0.85); color: #fff; border-color: #444;">1-PC CENTERLOCK</span>
          <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=600&q=80" alt="AGNI AF-08 Centerlock RS" />
        </div>
        <div class="wheel-card-body">
          <div class="wheel-code">AF-08 CENTERLOCK RS</div>
          <div class="wheel-subtitle">Direct OEM Spline for Porsche GT3 & 765LT</div>
          <div class="wheel-specs-list">
            <div class="spec-cell">
              <span class="spec-cell-label">WEIGHT FROM</span>
              <span class="spec-cell-value">8.7 KG (20")</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">DIAMETERS</span>
              <span class="spec-cell-value">20" – 21"</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">FITMENT TYPE</span>
              <span class="spec-cell-value">OEM Centerlock</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">STIFFNESS</span>
              <span class="spec-cell-value">Track GT Endurance</span>
            </div>
          </div>
          <div class="wheel-card-footer">
            <div>
              <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-secondary); display:block;">SET OF 4 FROM</span>
              <span class="wheel-price">$4,600</span>
            </div>
            <button class="btn-card-visualize" data-action="open-ai-garage" data-wheel-code="AF-08">
              <span>AI GARAGE</span>
            </button>
          </div>
        </div>
      </div>

      <!-- AF-10 CUSTOM THREE-PIECE (3-Piece) -->
      <div class="wheel-card" data-category="three-piece">
        <div class="wheel-card-media">
          <span class="badge-orange wheel-card-badge" style="background: rgba(255, 77, 0, 0.15); border-color: var(--color-accent); color: var(--color-accent);">3-PC CUSTOM</span>
          <img src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=600&q=80" alt="AGNI AF-10 Custom Three-Piece" />
        </div>
        <div class="wheel-card-body">
          <div class="wheel-code">AF-10 CUSTOM THREE-PIECE</div>
          <div class="wheel-subtitle">Floating Spoke Center + Reverse Rim Shell</div>
          <div class="wheel-specs-list">
            <div class="spec-cell">
              <span class="spec-cell-label">WEIGHT FROM</span>
              <span class="spec-cell-value">10.8 KG (20")</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">DIAMETERS</span>
              <span class="spec-cell-value">18" – 26"</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">CUSTOM WIDTHS</span>
              <span class="spec-cell-value">8.5J to 14.5J</span>
            </div>
            <div class="spec-cell">
              <span class="spec-cell-label">FASTENERS</span>
              <span class="spec-cell-value">24K Gold / Titanium</span>
            </div>
          </div>
          <div class="wheel-card-footer">
            <div>
              <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-secondary); display:block;">SET OF 4 FROM</span>
