<section id="gallery" class="section-dark" style="border-top: 1px solid var(--color-surface-border);">
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <div class="badge-orange" style="margin-bottom: 0.75rem;">AUTHENTIC BUILDS & TRACK EVIDENCE</div>
        <h2 class="heading-display" style="font-size: clamp(1.8rem, 3.5vw, 2.6rem);">PROVEN ON TARMAC & CURBS</h2>
      </div>
      <div style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-text-secondary);">
        FILTER: <span style="color: #fff; cursor: pointer;">ALL BUILDS</span> | <span>PORSCHE GT</span> | <span>BMW M</span> | <span>AUDI RS</span>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
      <!-- Build 1 -->
      <div style="background: var(--color-surface-dark); border: 1px solid var(--color-surface-border); border-radius: var(--radius-md); overflow: hidden;">
        <div style="aspect-ratio: 16/10; overflow: hidden; position: relative;">
          <img src="https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=700&q=80" alt="Porsche 992 GT3 with AGNI AF-01" style="width: 100%; height: 100%; object-fit: cover;" />
          <span class="badge-verified" style="position: absolute; top: 0.75rem; right: 0.75rem; background: rgba(0,0,0,0.85);">
            NÜRBURGRING TESTED
          </span>
        </div>
        <div style="padding: 1.25rem;">
          <div style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: #fff;">
            Porsche 911 GT3 (992) • Clubsport
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-accent); margin: 0.25rem 0 0.75rem;">
            AGNI AF-01 • Satin Charcoal • 20x9.5F / 21x12R
          </div>
          <div style="font-size: 0.8rem; color: var(--color-text-secondary); line-height: 1.5;">
            "Shed 3.8 kg of unsprung mass per corner compared to the factory forged wheels. Steering bite through high-speed transitions at the 'Ring is significantly sharper."
          </div>
        </div>
      </div>

      <!-- Build 2 -->
      <div style="background: var(--color-surface-dark); border: 1px solid var(--color-surface-border); border-radius: var(--radius-md); overflow: hidden;">
        <div style="aspect-ratio: 16/10; overflow: hidden; position: relative;">
          <img src="https://images.unsplash.com/photo-1580273916550-e323be2ae537?auto=format&fit=crop&w=700&q=80" alt="BMW M4 G82 with AGNI AF-02" style="width: 100%; height: 100%; object-fit: cover;" />
          <span class="badge-verified" style="position: absolute; top: 0.75rem; right: 0.75rem; background: rgba(0,0,0,0.85);">
            TRACK DAY VERIFIED
          </span>
        </div>
        <div style="padding: 1.25rem;">
          <div style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: #fff;">
            BMW M4 Competition (G82)
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-accent); margin: 0.25rem 0 0.75rem;">
            AGNI AF-02 • Liquid Titanium • 20x10.0F / 20x11.0R
          </div>
          <div style="font-size: 0.8rem; color: var(--color-text-secondary); line-height: 1.5;">
            "Custom ET14 front offset pushed the wheel flush with the fenders with zero rubbing under full compression. Knurled bead seats completely eliminated tire rotation on Cup 2s."
          </div>
        </div>
      </div>

      <!-- Build 3 -->
      <div style="background: var(--color-surface-dark); border: 1px solid var(--color-surface-border); border-radius: var(--radius-md); overflow: hidden;">
        <div style="aspect-ratio: 16/10; overflow: hidden; position: relative;">
          <img src="https://images.unsplash.com/photo-1603584173870-7f23fdae1b7a?auto=format&fit=crop&w=700&q=80" alt="Audi RS6 Avant C8 with AGNI AF-05" style="width: 100%; height: 100%; object-fit: cover;" />
          <span class="badge-verified" style="position: absolute; top: 0.75rem; right: 0.75rem; background: rgba(0,0,0,0.85);">
            DAILY & AUTOBAHN
          </span>
        </div>
        <div style="padding: 1.25rem;">
          <div style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: #fff;">
            Audi RS6 Avant (C8) Performance
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-accent); margin: 0.25rem 0 0.75rem;">
            AGNI AF-05 • Brushed Clear Anodized • 22x10.5J Square
          </div>
          <div style="font-size: 0.8rem; color: var(--color-text-secondary); line-height: 1.5;">
            "440mm ceramic brakes cleared with millimeter precision. Structural rigidity feels absolute at 300+ km/h on unrestricted Autobahn stints."
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Track Gallery",
  "settings": []
}
{% endschema %}

