<section id="fitment" class="section-dark" style="border-top: 1px solid var(--color-surface-border);">
  <div class="container">
    <div style="text-align: center; max-width: 680px; margin: 0 auto 3rem;">
      <div class="badge-orange" style="margin-bottom: 0.75rem;">AUTHORITATIVE CHASSIS DATABASE</div>
      <h2 class="heading-display" style="font-size: clamp(2rem, 3.8vw, 3rem);">VEHICLE FITMENT VERIFIER</h2>
      <p style="color: var(--color-text-secondary); font-size: 0.95rem; margin-top: 0.5rem;">
        No generic spacers or rubbing tires. Every AGNI specification is custom-calculated to clear large-format carbon ceramic calipers and flush-align with the fender lip.
      </p>
    </div>

    <div style="background: var(--color-surface-elevated); border: 1px solid var(--color-surface-border); border-radius: var(--radius-lg); padding: 2rem; max-width: 960px; margin: 0 auto;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
        <div>
          <label class="control-label">1. MAKE</label>
          <select id="fitment-select-make" style="width: 100%; background: #0c0d10; border: 1px solid var(--color-surface-border); border-radius: 4px; padding: 0.75rem; color: #fff; font-family: var(--font-mono); font-size: 0.82rem;">
            <option value="Porsche">Porsche</option>
            <option value="BMW">BMW</option>
            <option value="Audi">Audi</option>
            <option value="Mercedes-AMG">Mercedes-AMG</option>
            <option value="Nissan">Nissan</option>
            <option value="Chevrolet">Chevrolet</option>
          </select>
        </div>

        <div>
          <label class="control-label">2. MODEL</label>
          <select id="fitment-select-model" style="width: 100%; background: #0c0d10; border: 1px solid var(--color-surface-border); border-radius: 4px; padding: 0.75rem; color: #fff; font-family: var(--font-mono); font-size: 0.82rem;">
            <option value="911 GT3 (992)">911 GT3 (992)</option>
          </select>
        </div>

        <div>
          <label class="control-label">3. YEAR</label>
          <select id="fitment-select-year" style="width: 100%; background: #0c0d10; border: 1px solid var(--color-surface-border); border-radius: 4px; padding: 0.75rem; color: #fff; font-family: var(--font-mono); font-size: 0.82rem;">
            <option value="2024">2024</option>
            <option value="2023">2023</option>
            <option value="2022">2022</option>
          </select>
        </div>

        <div>
          <label class="control-label">4. TRIM & BRAKES</label>
          <select id="fitment-select-trim" style="width: 100%; background: #0c0d10; border: 1px solid var(--color-surface-border); border-radius: 4px; padding: 0.75rem; color: #fff; font-family: var(--font-mono); font-size: 0.82rem;">
            <option value="GT3 Standard / Touring (Centerlock)">GT3 Standard / Touring (Centerlock)</option>
            <option value="GT3 RS (992)">GT3 RS (992)</option>
          </select>
        </div>
      </div>

      <!-- Fitment Result Box -->
      <div id="fitment-result-card" style="background: #090a0d; border: 1px solid var(--color-surface-border-active); border-radius: var(--radius-md); padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
          <div style="font-family: var(--font-display); font-size: 1.15rem; font-weight: 700;">
            <span id="fitment-car-title">Porsche 911 GT3 (992) • 2024</span>
          </div>
          <div class="badge-verified" id="fitment-status-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>VERIFIED FITMENT GUARANTEED</span>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; border-top: 1px solid var(--color-surface-border); border-bottom: 1px solid var(--color-surface-border); padding: 1rem 0;">
          <div>
            <div style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-muted);">BOLT PATTERN / PCD</div>
            <div style="font-family: var(--font-mono); font-size: 0.9rem; font-weight: 700; color: #fff;" id="fitment-pcd-val">Centerlock (84.0mm CB)</div>
          </div>
          <div>
            <div style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-muted);">FRONT SPEC</div>
            <div style="font-family: var(--font-mono); font-size: 0.9rem; font-weight: 700; color: #fff;" id="fitment-front-val">20" x 9.5J ET46</div>
          </div>
          <div>
            <div style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-muted);">REAR SPEC</div>
            <div style="font-family: var(--font-mono); font-size: 0.9rem; font-weight: 700; color: #fff;" id="fitment-rear-val">21" x 12.0J ET45</div>
          </div>
          <div>
            <div style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-muted);">BRAKE CALIPER COMPATIBILITY</div>
            <div style="font-family: var(--font-mono); font-size: 0.9rem; font-weight: 700; color: #fff;" id="fitment-brakes-val">410mm PCCB Cleared</div>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <div style="font-size: 0.75rem; color: var(--color-text-secondary);">
            Visual preview only. Final fitment subject to verification by AGNI Engineering before forging.
          </div>
          <button class="btn-primary" data-action="open-ai-garage" style="padding: 0.75rem 1.5rem; font-size: 0.8rem;">
            LAUNCH AI GARAGE WITH THIS SETUP
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fitment Finder",
  "settings": []
}
{% endschema %}

