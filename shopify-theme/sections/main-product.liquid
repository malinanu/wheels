<section class="section-dark" style="padding-top: 2.5rem;">
  <div class="container">
    <!-- Breadcrumb -->
    <nav style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-text-secondary); margin-bottom: 2rem;">
      <a href="/" style="color: var(--color-text-muted);">ARCHIVE</a> / 
      <a href="#collection" style="color: var(--color-text-muted);">MONOBLOCK</a> / 
      <span style="color: #fff;">AF-01 TWIN 5-SPOKE</span>
    </nav>

    <div style="display: grid; grid-template-columns: 1fr; gap: 3.5rem; align-items: flex-start;" class="pdp-layout-grid">
      <!-- Media Gallery Column -->
      <div>
        <div style="aspect-ratio: 1; background: radial-gradient(circle at center, #1b1c22 0%, #0c0d10 80%); border: 1px solid var(--color-surface-border); border-radius: var(--radius-md); overflow: hidden; position: relative; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
          <img id="pdp-main-image" src="https://images.unsplash.com/photo-1578844251758-2f71da64c96f?auto=format&fit=crop&w=1000&q=85" alt="AGNI AF-01 Forged Monoblock Wheel" style="width: 85%; height: 85%; object-fit: contain;" />
          <button class="btn-primary" data-action="open-ai-garage" data-wheel-code="AF-01" style="position: absolute; bottom: 1.25rem; left: 1.25rem; font-size: 0.75rem; padding: 0.65rem 1.25rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>TEST-FIT IN AI GARAGE</span>
          </button>
        </div>

        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;">
          <div style="aspect-ratio: 1; background: #111216; border: 1px solid var(--color-surface-border-active); border-radius: 4px; overflow: hidden; padding: 0.5rem; cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1578844251758-2f71da64c96f?auto=format&fit=crop&w=200&q=80" alt="Face-on" style="width: 100%; height: 100%; object-fit: contain;" />
          </div>
          <div style="aspect-ratio: 1; background: #111216; border: 1px solid var(--color-surface-border); border-radius: 4px; overflow: hidden; padding: 0.5rem; cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1611821064430-0d40291d0f0b?auto=format&fit=crop&w=200&q=80" alt="Deep Concave 45°" style="width: 100%; height: 100%; object-fit: contain;" />
          </div>
          <div style="aspect-ratio: 1; background: #111216; border: 1px solid var(--color-surface-border); border-radius: 4px; overflow: hidden; padding: 0.5rem; cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1563720223185-11003d516935?auto=format&fit=crop&w=200&q=80" alt="CNC Milling Texture Macro" style="width: 100%; height: 100%; object-fit: contain;" />
          </div>
          <div style="aspect-ratio: 1; background: #111216; border: 1px solid var(--color-surface-border); border-radius: 4px; overflow: hidden; padding: 0.5rem; cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?auto=format&fit=crop&w=200&q=80" alt="Back-Pad Chamfer" style="width: 100%; height: 100%; object-fit: contain;" />
          </div>
        </div>
      </div>

      <!-- Purchase Details & CRO Column -->
      <div style="position: sticky; top: 90px;">
        <div class="badge-orange" style="margin-bottom: 0.5rem;">BESPOKE PRODUCTION RUN</div>
        <h1 class="heading-display" style="font-size: 2.4rem; color: #fff; margin-bottom: 0.5rem;">AF-01 MONOBLOCK</h1>
        <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin-bottom: 1.5rem;">
          Ultralight twin 5-spoke monoblock engineered for extreme cornering stiffness, maximum caliper clearance, and unsprung mass optimization.
        </p>

        <!-- Pricing & Quantity -->
        <div style="display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1.5rem;">
          <div style="font-family: var(--font-mono); font-size: 2rem; font-weight: 800; color: #fff;">$4,600</div>
          <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text-secondary);">FOR SET OF 4 WHEELS</div>
        </div>

        <!-- Vehicle Fitment Bar -->
        <div style="background: var(--color-surface-elevated); border: 1px solid var(--color-surface-border); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span class="control-label" style="margin: 0;">TARGET CHASSIS FITMENT</span>
            <span class="badge-verified">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              VERIFIED
            </span>
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600; color: #fff;">
            2024 Porsche 911 GT3 (992) • Centerlock
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-text-secondary); margin-top: 0.25rem;">
            Front: 20x9.5J ET46 | Rear: 21x12.0J ET45 (PCCB Cleared)
          </div>
        </div>

        <!-- Finish Swatches -->
        <div style="margin-bottom: 1.5rem;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
            <span class="control-label" style="margin: 0;">FINISH:</span>
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: #fff;" id="pdp-selected-finish">Satin Charcoal</span>
          </div>
          <div class="finish-selection-row">
            <button class="finish-swatch-btn swatch-satin-charcoal is-active" data-finish="Satin Charcoal"></button>
            <button class="finish-swatch-btn swatch-liquid-titanium" data-finish="Liquid Titanium"></button>
            <button class="finish-swatch-btn swatch-molten-gold" data-finish="Molten Gold Anodized"></button>
            <button class="finish-swatch-btn swatch-gloss-black" data-finish="Gloss Piano Black"></button>
            <button class="finish-swatch-btn swatch-brushed-clear" data-finish="Brushed Clear Anodized"></button>
          </div>
        </div>

        <!-- Diameter Selector -->
        <div style="margin-bottom: 1.75rem;">
          <span class="control-label">DIAMETER & STAGGER SPECIFICATION</span>
          <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem;">
            <button class="filter-pill" style="text-align: center;">19" / 19"</button>
            <button class="filter-pill active" style="text-align: center;">20" / 21"</button>
            <button class="filter-pill" style="text-align: center;">20" / 20"</button>
            <button class="filter-pill" style="text-align: center;">21" / 22"</button>
          </div>
        </div>

        <!-- Dynamic Buy Button & Sticky Add to Cart -->
        <div style="margin-bottom: 1.5rem;">
          <button class="btn-primary" onclick="AgniCart.addItem({ id: 'af01', title: 'AGNI AF-01 Monoblock Set (x4)', price: 4600, properties: { 'Vehicle': 'Porsche 911 GT3 (992)', 'Finish': 'Satin Charcoal', 'Fitment Status': 'VERIFIED' } }); AgniCart.openDrawer();" style="width: 100%; padding: 1.1rem;">
            ADD TO PRODUCTION QUEUE — $4,600
          </button>
        </div>

        <!-- Trust Badges -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-text-secondary); border-top: 1px solid var(--color-surface-border); padding-top: 1.25rem;">
          <div>⚡ 4–6 WEEKS FORGE LEAD TIME</div>
          <div>✈ FREE GLOBAL EXPRESS FREIGHT</div>
          <div>🛡 5-YEAR STRUCTURAL GUARANTEE</div>
          <div>🔧 CAD VERIFICATION BEFORE CNC</div>
        </div>
      </div>
    </div>

    <!-- Below the Fold Engineering Accordions -->
    <div style="margin-top: 5rem; border-top: 1px solid var(--color-surface-border); padding-top: 3.5rem;">
      <h3 class="heading-display" style="font-size: 1.8rem; margin-bottom: 2rem;">TECHNICAL SPECIFICATIONS & ARCHITECTURE</h3>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
        <div style="background: var(--color-surface-elevated); border: 1px solid var(--color-surface-border); border-radius: var(--radius-md); padding: 1.5rem;">
          <div style="font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem;">
            01. MATERIAL INTEGRITY
          </div>
          <p style="font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.6;">
            Forged from solid 6061-T6 aerospace aluminum billet under 10,000 tons of hydraulic pressure. Eliminates internal voids and porosity common in cast wheels.
          </p>
        </div>

        <div style="background: var(--color-surface-elevated); border: 1px solid var(--color-surface-border); border-radius: var(--radius-md); padding: 1.5rem;">
          <div style="font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem;">
            02. WEIGHT REDUCTION
          </div>
          <p style="font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.6;">
            Starting at 8.8 kg per wheel. Reduced rotational inertia delivers immediate throttle response, shorter braking distances, and elevated tire contact patch grip.
          </p>
        </div>

        <div style="background: var(--color-surface-elevated); border: 1px solid var(--color-surface-border); border-radius: var(--radius-md); padding: 1.5rem;">
          <div style="font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem;">
            03. KNURLED BEAD SEATS
          </div>
          <p style="font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.6;">
            Precision micro-grooves machined along inner and outer tire bead seats mechanically lock tires into place, eliminating tire slippage during high-G launch control.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
@media (min-width: 960px) {
  .pdp-layout-grid {
    grid-template-columns: 1.25fr 1fr !important;
  }
}
</style>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}

